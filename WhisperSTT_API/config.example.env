# Copy to config.local.env (or use .env) and adjust paths.

WHISPER_CPP_DIR=whisper.cpp
WHISPER_MODEL=models/ggml-base.en.bin
WHISPER_SERVER_HOST=127.0.0.1
WHISPER_SERVER_PORT=8081
WHISPER_SERVER_INFERENCE_PATH=/inference
NEUS_WHISPER_API_KEY=
NEUS_WHISPER_MAX_UPLOAD_BYTES=26214400
FFMPEG=ffmpeg
WHISPER_THREADS=4

# Auto-start local whisper-server on first API request (Windows/Linux native).
# Set 0 on Hostinger Docker — compose handles whisper-server restart.
NEUS_WHISPER_AUTO_START=1

# Retry behavior when whisper-server is briefly busy (single-threaded).
# The proxy will retry N times with linear backoff before returning 502.
NEUS_WHISPER_RETRY_ATTEMPTS=3
NEUS_WHISPER_RETRY_DELAY_MS=500
