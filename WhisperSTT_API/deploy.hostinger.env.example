# Deploy target — copy to deploy.hostinger.env (local only, gitignored).
# Used by scripts/deploy-hostinger.{sh,ps1} to deploy from GitHub onto the VPS:
# the script SSHes in, clones/pulls this repo, and runs docker compose.

HOSTINGER_SSH_HOST=your.vps.host
HOSTINGER_SSH_USER=root
HOSTINGER_SSH_PORT=22
HOSTINGER_REMOTE_DIR=/root/neuswhisper

# GitHub repo to deploy from (must be reachable from the VPS).
NEUS_WHISPER_REPO_URL=https://github.com/ZakRowton/APIs.git
NEUS_WHISPER_REPO_BRANCH=main
