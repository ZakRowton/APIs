* text=auto

# Must be LF so they run on the Linux VPS and inside Docker containers.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.env text eol=lf
*.env.example text eol=lf

# Windows-only scripts stay CRLF.
*.ps1 text eol=crlf

# Binary assets (never normalize).
*.bin binary
*.wav binary
*.m4a binary
*.mlmodel binary
