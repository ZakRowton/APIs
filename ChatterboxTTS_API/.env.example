# Port exposed on the host
API_PORT=4123

# Default voice (see /v1/voices endpoint for full list)
# Popular voices: af_heart, af_bella, af_nicole, af_sky, am_adam, am_eric, am_michael
KOKORO_DEFAULT_VOICE=af_heart

# Optional: custom model/voices paths (auto-downloaded if not set)
# KOKORO_MODEL_PATH=/path/to/kokoro_fp16.onnx
# KOKORO_VOICES_PATH=/path/to/voices-v1.0.bin
# KOKORO_CACHE_DIR=/cache/kokoro

# Pre-load model on container start (recommended)
WARMUP_ON_START=1

# Optional: leave empty to disable auth
API_KEY=

# CORS: comma-separated origins, or * for all
CORS_ORIGINS=*

# Docker memory limit — Kokoro only needs 1-2GB (vs 8GB for Chatterbox)
MEMORY_LIMIT=2g